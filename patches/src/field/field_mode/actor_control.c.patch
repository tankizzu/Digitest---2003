+#ifdef NATIVE
+/* Touch: near a character the player can talk to, the balloon over the
+   player's head (as on an exit's cell); a tap then talks to it, turned to it */
+#define NATIVE_TALK_BALLOON 0x7A /* the balloon's task id */
+#define NATIVE_TALK_ANIM 1       /* its FIELDSTG_triggerAnims row: the scribble the scenes show */
+#define NATIVE_TALK_REACH 30     /* how near, in the map's tile units */
+
+/* The character nearest the player within reach that a talk can go to: not a
+   partner (they follow a trail), not one of 0x180 to 0x182 */
+static Actor *nativeTalkable(Actor *player) {
+    Actor *actor = TASK_REGISTRY.funcs.find(FIELD_TASK_ACTOR, -1, -1);
+    Actor *best = NULL;
+    s32 bestDist = NATIVE_TALK_REACH * NATIVE_TALK_REACH + 1;
+
+    for (; actor != NULL; actor = TASK_REGISTRY.funcs.findNext()) {
+        s32 dx = actor->tile.x - player->tile.x, dy = actor->tile.y - player->tile.y;
+
+        if (actor == player || actor->trail != NULL || actor->state != TASK_RUN || actor->key1 == 0x180
+            || actor->key1 == 0x181 || actor->key1 == 0x182) {
+            continue;
+        }
+        if (dx * dx + dy * dy < bestDist) {
+            bestDist = dx * dx + dy * dy;
+            best = actor;
+        }
+    }
+    return best;
+}
+
+/* The balloon shown while there is someone to talk to (and no exit's balloon is up), shut when there isn't. It is
+   the player's own child (ActorChildren.balloon, the gauge game's otherwise), so that it runs with the player */
+static void nativeTalkBalloon(Actor *player, Actor *target) {
+    Balloon **slot = &((ActorChildren *)player->children)->balloon;
+    Balloon *balloon = *slot;
+
+    if (balloon != NULL && balloon->id != NATIVE_TALK_BALLOON) {
+        return; /* the gauge game's */
+    }
+    if (target != NULL && TASK_REGISTRY.funcs.find(6, -1, -1) == NULL) {
+        if (balloon == NULL) {
+            *slot = FIELDSTG_createBalloon(0, NATIVE_TALK_ANIM, NATIVE_TALK_BALLOON);
+        } else if (balloon->state == TASK_DONE) {
+            balloon->setState(balloon, TASK_RUN);
+            balloon->frame = 0, balloon->time = 0;
+        }
+    } else if (balloon != NULL && balloon->state == TASK_RUN) {
+        balloon->setState(balloon, TASK_DONE);
+    }
+}
+
+/* The direction (FIELDSTG_dirSteps) nearest the way from one tile to another */
+static s32 nativeDirTo(Vec2 *from, Vec2 *to) {
+    s32 dx = to->x - from->x, dy = to->y - from->y;
+    s32 i, best = 0, bestDot = -0x7FFFFFFF;
+
+    for (i = 0; i < 8; i++) {
+        s32 dot = dx * FIELDSTG_dirSteps[i].x + dy * FIELDSTG_dirSteps[i].y;
+        if (dot > bestDot) {
+            bestDot = dot;
+            best = i;
+        }
+    }
+    return best;
+}
