+#ifdef NATIVE
+/* Upright (platform/portrait.c): the 30 streams on 4 columns from the view's left and the rows in view, the row
+   below, then the one above, in that order (requestTiles reads them first to last) */
+static void nativePickUprightTiles(MapStreamer *task) {
+    s32 top = task->scroll.y >= 0 ? task->scroll.y / 128 : -1;
+    s32 last = (task->scroll.y + native_field_h()) / 128;
+    s32 order[7];
+    s32 n = 0, k = 0, i, c, y, x;
+
+    for (y = top; y <= last && n < 6; y++) {
+        order[n++] = y;
+    }
+    order[n++] = last + 1;
+    if (n < 7) {
+        order[n++] = top - 1;
+    }
+    for (i = 0; i < 30; i++) {
+        task->viewTiles[i] = 0xFF;
+    }
+    task->viewX = task->scroll.x / 128;
+    task->viewY = top;
+    for (i = 0; i < n; i++) {
+        y = order[i];
+        for (c = 0; c < 4; c++, k++) {
+            x = task->viewX + c;
+            if (y >= 0 && y < task->height && x >= 0 && x < task->width) {
+                task->viewTiles[k] = x + y * task->width;
+            }
+        }
+    }
+}
+#endif
