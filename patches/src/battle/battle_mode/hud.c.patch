 /* Draws the battle HUD: both HP bars, the technique gauge (full at 1000) and
    the fighters' icons */
+#ifdef NATIVE
+/* Upright: a HUD sprite or quad of a piece (types.h's NATIVE_XF), where the user put it */
+static void nativeHudDraw(SpriteDrawer *d, void *sheet, s32 frame, s32 x, s32 y, s32 piece) {
+    if (native_portrait()) {
+        const NativeXf *f = NXF(piece);
+
+        NXF_SPRITE(*d, f);
+        d->draw(sheet, frame, x + NXF_DX(f), y + NXF_DY(f));
+        NXF_SPRITE_END(*d);
+    } else {
+        d->draw(sheet, frame, x, y);
+    }
+}
+
+static void nativeHudQuad(DVECTOR *points, CVECTOR *colors, s32 piece) {
+    DVECTOR moved[4];
+    s32 k;
+
+    if (!native_portrait()) {
+        FIGHTSTG_battle.drawQuad(BATTLE_LAYER_MENUS, 1, points, colors);
+        return;
+    }
+    for (k = 0; k < 4; k++) {
+        moved[k].vx = NXF_X(NXF(piece), points[k].vx);
+        moved[k].vy = NXF_Y(NXF(piece), points[k].vy);
+    }
+    FIGHTSTG_battle.drawQuad(BATTLE_LAYER_MENUS, 1, moved, colors);
+}
+
+/* its texts (names and HP), each frame */
+static void nativeHudTexts(TextWindow **windows) {
+    static const s16 AT[5][3] = {
+        {0xAE, 0x15, NXF_PARTNER}, {0x11, 0x15, NXF_ENEMY}, {0x10C, 0x1A, NXF_PARTNER}, {0x12E, 0x1A, NXF_PARTNER},
+        {0x10B, 0x1A, NXF_PARTNER},
+    };
+    s32 i;
+
+    for (i = 0; native_portrait() && i < 5; i++) {
+        if (windows[i] != NULL) {
+            NXF_TEXT(windows[i], NXF(AT[i][2]), AT[i][0], AT[i][1]);
+        }
+    }
+}
+#endif
