+#ifdef NATIVE
+/* Upright, a battle list where the user put it (f, types.h): a finger on it taps a row (picked and confirmed, X) or
+   drags: up or left turns to the next page (R1), down or right to the previous one (L1), a page per drag of 36
+   pixels. The list's own taps and pages stay the game's: this only presses its buttons */
+void native_battle_list(MenuCursor *cursor, const NativeXf *f) {
+    static s32 accX, accY, idle;
+    s32 y, dy, dx, ev, row, rowH;
+
+    cursor->nativeXf = f;
+    native_touch_list(f->x, f->y, f->w, f->h);
+    ev = native_touch_list_event(&y, &dy);
+    dx = native_touch_list_dx();
+    if (dx == 0 && dy == 0) {
+        if (++idle > 8) {
+            accX = accY = 0; /* the finger off or still: a new drag starts from nothing */
+        }
+    } else {
+        idle = 0;
+        accX += dx, accY += dy;
+    }
+    if (ev == 1 && cursor->locked == 0) {
+        rowH = cursor->params.step * f->h / f->oh;
+        row = rowH > 0 ? (y - NXF_Y(f, cursor->params.y - 2)) / rowH : -1;
+        if (y >= NXF_Y(f, cursor->params.y - 2) && row >= 0 && row < cursor->params.count) {
+            if (cursor->sel != row) {
+                SOUND.playSound(SOUND_MENU_MOVE);
+            }
+            cursor->sel = row;
+            native_touch_hold(PAD_CROSS, 3);
+        }
+        accX = accY = 0;
+        return;
+    }
+    if (accX <= -36 || accY <= -36) {
+        native_touch_hold(PAD_R1, 3);
+        accX = accY = 0;
+    } else if (accX >= 36 || accY >= 36) {
+        native_touch_hold(PAD_L1, 3);
+        accX = accY = 0;
+    }
+}
+#endif
