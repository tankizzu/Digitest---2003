+#ifdef NATIVE
+/* Upright, each frame while the bar's vsync callback is this cursor's: the bar (the dot blinking in the picked line's
+   square) as a quad of its frame in VRAM (FIGHTSTG_cursorBarRect's row), on top of the menus' layer and scaled like
+   the line's sprite. The game copies it into the shown buffer at the vsync instead: the one tall screen is drawn
+   whole each frame, which would cover it */
+static void nativeCursorDot(MenuCursor *task) {
+    Layer *layer = GFX.funcs.getLayer(BATTLE_LAYER_MENUS);
+    POLY_FT4 *q;
+    s32 x, y, w, h;
+
+    if (layer == NULL) {
+        return;
+    }
+    if (NATIVE_CMD_GRID(task->params)) { /* the row's sprite is scaled to a button of the grid (FIGHTSTG_drawCursorSprites) */
+        x = NATIVE_CMD_X(task->sel) + (task->params.x - task->params.spriteX) * NATIVE_CMD_W / 97;
+        y = NATIVE_CMD_Y(task->sel) + (task->params.y - task->params.spriteY) * NATIVE_CMD_H / 18;
+        w = 12 * NATIVE_CMD_W / 97;
+        h = 12 * NATIVE_CMD_H / 18;
+    } else if (task->nativeXf != NULL) { /* a list where the user put it */
+        const NativeXf *f = task->nativeXf;
+
+        x = NXF_X(f, task->params.x);
+        y = NXF_Y(f, task->params.y + task->sel * task->params.step);
+        w = 12 * f->w / f->ow;
+        h = 12 * f->h / f->oh;
+    } else {
+        x = task->params.x;
+        y = task->params.y + task->sel * task->params.step;
+        w = h = 12;
+    }
+    q = GFX.funcs.getPrim();
+    setPolyFT4(q);
+    setRGB0(q, 0x80, 0x80, 0x80);
+    setXYWH(q, x, y, w, h);
+    q->u0 = q->u2 = task->frame * 12;
+    q->u1 = q->u3 = task->frame * 12 + 11;
+    q->v0 = q->v1 = FIGHTSTG_cursorBarRect.y;
+    q->v2 = q->v3 = FIGHTSTG_cursorBarRect.y + 11;
+    q->tpage = GetTPage(2, 0, 0, 0);
+    q->clut = 0;
+    addPrim(layer->getOtEntry(layer, 0), q);
+    GFX.funcs.setPrim(q + 1);
+}
+#endif
 
