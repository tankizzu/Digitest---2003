+/* Upright, under the frame: the picked save's picture in the game's small box */
+static void nativeDrawThumb(MemCardSaves *saves, SpriteDrawer *sprite) {
+    s32 i = nativeThumbSlot;
+    Layer *layer;
+    PrimPtr prim;
+    u_long *ot;
+    Vec2 scroll;
+
+    if (i < 0) {
+        return;
+    }
+    sprite->setLayerId(saves->layer, 1);
+    sprite->setScale(ONE * 176 / 117, ONE * 136 / 33, ONE);
+    sprite->setPivot(NATIVE_THUMB_X - 8, NATIVE_THUMB_Y - 8);
+    sprite->draw(FILE_CACHE.getEntry(FILE_GMCARD_SHEET << 16), 29, NATIVE_THUMB_X - 8, NATIVE_THUMB_Y - 8);
+    sprite->setScale(ONE, ONE, ONE);
+    layer = GFX.funcs.getLayer(saves->layer);
+    layer->getScroll(layer, &scroll);
+    ot = layer->getOtEntry(layer, 0);
+    prim.any = GFX.funcs.getPrim();
+    SetSprt(prim.sprt);
+    prim.sprt->r0 = prim.sprt->g0 = prim.sprt->b0 = 0x80;
+    prim.sprt->x0 = NATIVE_THUMB_X - scroll.x;
+    prim.sprt->y0 = NATIVE_THUMB_Y - scroll.y;
+    prim.sprt->u0 = 0;
+    prim.sprt->v0 = NATIVE_THUMB_VY(i) - 768;
+    prim.sprt->w = 160;
+    prim.sprt->h = 120;
+    prim.sprt->clut = 0;
+    addPrim(ot, prim.any);
+    prim.sprt++;
+    SetDrawTPage(prim.tpage, 0, 1, GetTPage(2, 0, NATIVE_THUMB_VX(i), 768));
+    addPrim(ot, prim.any);
+    prim.tpage++;
+    GFX.funcs.setPrim(prim.any);
+}
