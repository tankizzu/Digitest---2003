+static void nativePickSlot(MemCardSaves *saves, MemCardSavesWindows *win) {
+    s32 i, prev = nativeSel, tapped = -1, back = nativeBackTap();
+
+    for (i = 0; i < NATIVE_SLOTS; i++) {
+        native_touch_target(0x7A60 + i, NATIVE_BOX_X, NATIVE_BOX_Y(i) - 2, NATIVE_BOX_W, NATIVE_BOX_H + 4);
+    }
+    for (i = 0; i < NATIVE_SLOTS; i++) {
+        if (native_touch_tap_id(0x7A60 + i)) {
+            tapped = i;
+        }
+    }
+    if (PAD_PRESSED(PAD_UP) && nativeSel > 0) {
+        nativeSel--;
+    } else if (PAD_PRESSED(PAD_DOWN) && nativeSel < NATIVE_SLOTS - 1) {
+        nativeSel++;
+    }
+    if (tapped >= 0) {
+        nativeSel = tapped;
+    }
+    if (prev != nativeSel) {
+        SOUND.playSound(SOUND_CURSOR);
+    }
+    if (tapped >= 0 || PAD_PRESSED(PAD_CROSS)) {
+        nativeGame = nativeSel + 1;
+        if (native_replace_is_pending()) { /* a new game's slot: replace it? */
+            SOUND.playSound(SOUND_SELECT);
+            nativeStep = 2;
+            saves->substate = 6;
+            nativeShowRows(saves, win);
+        } else if (native_game_exists(nativeGame)) { /* load or delete it */
+            SOUND.playSound(SOUND_SELECT);
+            nativeStep = 0;
+            saves->substate = 5;
+            nativeShowRows(saves, win);
+        } else {
+            SOUND.playSound(SOUND_MENU_CANCEL); /* an empty slot: nothing to load */
+        }
+    } else if (back) {
+        native_replace_pending(0);
+        nativeLeave(saves);
+    }
+}
