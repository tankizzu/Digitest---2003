+    s32 i;
+
+    HEAP.zero(file, sizeof(MemCardFile));
+    file->magic = MEMCARD_FILE_MAGIC;
+    file->version = MEMCARD_SAVE_VERSION;
+    for (i = 0; i < 3; i++) {
+        nativeAutoSlot[i] = i < 2 ? native_autosave_read_slot(nativeGame, i, STGMCARD_funcs.dataBuf) : -1;
+        if (nativeAutoSlot[i] >= 0) {
+            nativeFillInfo(&file->saves[i], STGMCARD_funcs.dataBuf);
+        }
+    }
+    saves->file = *file;
+    STGMCARD_funcs.lastSlot = 0;
+    nativeAutoList = 1;
+    saves->port = 0;
+    win->windows[1]->setVisible(win->windows[1], 0);
+    win->windows[2]->setVisible(win->windows[2], 0);
+    win->windows[3]->setVisible(win->windows[3], 0);
+    win->cursor->setVisible(win->cursor, 0);
+    if (win->panel == NULL) {
+        win->panel = STGMCARD_createPanel(0xCD, 0xC1, 0x62, 0xA);
+    }
+    win->panel->setTopColor(win->panel, 0x7F, 0x32, 0xF2);
+    win->panel->setBottomColor(win->panel, 0xD1, 0x2F, 0xDE);
