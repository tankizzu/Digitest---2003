+/* Strings of the MEMCRD file, one row each (a blank line between), into nativeListText */
+static void nativeListStrings(const s32 *ids, s32 n) {
+    u8 *file = (u8 *)FILE_CACHE.load(TEXT_FILE(TEXT_MEMORY_CARD));
+    s32 pos = 0, i;
+
+    for (i = 0; i < n; i++) {
+        u8 *src = file + ((s32 *)file)[1 + ids[i]];
+
+        if (i > 0) {
+            nativeListText[pos++] = 2, nativeListText[pos++] = 1, nativeListText[pos++] = 2, nativeListText[pos++] = 1;
+        }
+        while (*src != 0 && pos < (s32)sizeof nativeListText - 8) {
+            nativeListText[pos++] = *src++;
+        }
+    }
+    nativeListText[pos] = 0;
+}
