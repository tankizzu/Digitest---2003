+/* The MEMORY CARD's name, at the game's first save: typed with the phone's keyboard, shown with the game's font in
+   the frame's left box (a tap shows the keyboard again), OK in the right one (or the keyboard's Enter) keeps it;
+   empty, the card stays "MEMORY CARD N". The back arrow leaves without saving. Sideways: the name in the frame's
+   text, a tap shows the keyboard, Enter keeps it */
+static void nativeNameShow(MemCardSavesWindows *win) {
+    native_text_encode(nativeName, nativeNameText, sizeof nativeNameText);
+    win->windows[0]->setString(win->windows[0], nativeNameText, -1);
+}
+
+static void nativeNameStart(MemCardSaves *saves, MemCardSavesWindows *win) {
+    nativeNameLen = 0;
+    nativeName[0] = 0;
+    saves->substate = 8;
+    win->cursor->setVisible(win->cursor, 0);
+    win->windows[2]->setVisible(win->windows[2], 0);
+    win->windows[1]->setString(win->windows[1], FILE_CACHE.load(TEXT_FILE(TEXT_MEMORY_CARD)), 0x31);
+    if (NATIVE_UP) {
+        win->windows[0]->setPos(win->windows[0], NATIVE_BTN_X(0) + 14, NATIVE_BTN_Y + 13);
+        win->windows[0]->setLines(win->windows[0], 1);
+        win->windows[0]->setDepth(win->windows[0], 0);
+        win->windows[3]->setDepth(win->windows[3], 0);
+        win->windows[3]->setPos(win->windows[3], NATIVE_BTN_X(1) + 56, NATIVE_BTN_Y + 13);
+        win->windows[3]->setString(win->windows[3], FILE_CACHE.load(TEXT_FILE(TEXT_MEMORY_CARD)), 0x32);
+        win->windows[4]->setVisible(win->windows[4], 0);
+    }
+    nativeNameShow(win);
+}
+
+static void nativeNameInput(MemCardSaves *saves, MemCardSavesWindows *win) {
+    s32 ch, ok = 0, changed = 0, back = NATIVE_UP ? nativeBackTap() : PAD_PRESSED(PAD_TRIANGLE), tap;
+
+    native_touch_no_stick();
+    native_text_begin();
+    if (NATIVE_UP) {
+        tap = nativeButtonTap();
+        if (tap == 0) {
+            native_text_reopen(); /* the name's box: the keyboard again */
+        }
+        ok = tap == 1;
+    } else if (native_touch_anywhere()) {
+        native_text_reopen();
+    }
+    while (!ok && (ch = native_text_next()) >= 0) {
+        if (ch == 13) {
+            ok = 1;
+        } else if (ch == 8) {
+            if (nativeNameLen > 0) {
+                nativeName[--nativeNameLen] = 0;
+                changed = 1;
+            }
+        } else if (native_name_char(ch) && nativeNameLen < NATIVE_NAME_MAX && (ch != ' ' || nativeNameLen > 0)) {
+            nativeName[nativeNameLen++] = (char)ch;
+            nativeName[nativeNameLen] = 0;
+            changed = 1;
+        }
+    }
+    if (changed) {
+        SOUND.playSound(SOUND_CURSOR);
+        nativeNameShow(win);
+    }
+    if (ok) {
+        native_game_set_name(native_game_current(), nativeName);
+        if (NATIVE_UP) {
+            nativeRestoreWindows(saves, win);
+        }
+        nativeStartCheck(saves, win);
+    } else if (back) {
+        nativeLeave(saves);
+    }
+}
+
+/* The games: X or a tap picks one; triangle leaves */
+static void nativePickGame(MemCardSaves *saves, MemCardSavesWindows *win) {
+    s32 count = native_game_count(), prevTop = nativeTop, prevSel = nativeSel, game;
+
+    if (saves->screen->loading == 0) { /* saving: the game being played, without asking */
+        if (native_game_current() == 0) {
+            native_game_new();
+        }
+        if (!native_game_named(native_game_current())) { /* its first save: its name first */
+            nativeNameStart(saves, win);
+            return;
+        }
+        if (NATIVE_UP) {
+            nativeRestoreWindows(saves, win); /* the slots' column moved them */
+        }
+        nativeStartCheck(saves, win);
+        return;
+    }
+    if (NATIVE_UP) {
+        nativePickSlot(saves, win);
+        return;
+    }
+    if (count == 0) {
+        native_touch_in_menu();
+        if (MC_CROSS() || PAD_PRESSED(PAD_TRIANGLE) || native_touch_anywhere()) {
+            nativeLeave(saves);
+        }
+        return;
+    }
+    switch (nativeListInput(&nativeSel, count, &nativeTop)) {
+    case 0:
+        break;
+    case 2: /* held: delete it? */
+        SOUND.playSound(SOUND_SELECT);
+        nativeDelete = nativeSel;
+        nativeSource = 1; /* no, to start with */
+        saves->substate = 6;
+        nativeShowRows(saves, win);
+        return;
+    default:
+        game = native_game_number(nativeSel);
+        native_game_select(game);
+        if (native_autosave_exists(game)) {
+            SOUND.playSound(SOUND_SELECT);
+            nativeSource = 0;
+            saves->substate = 5;
+            nativeShowRows(saves, win);
+        } else {
+            nativeStartCheck(saves, win);
+        }
+        return;
+    }
+    if (PAD_PRESSED(PAD_TRIANGLE)) {
+        nativeLeave(saves);
+        return;
+    }
+    if (prevTop != nativeTop || prevSel != nativeSel) {
+        nativeShowRows(saves, win);
+    }
+}
+
+/* Where to continue the game from: its autosave (loaded at the frame's end, platform/state.c) or its saves */
+static void nativePickSource(MemCardSaves *saves, MemCardSavesWindows *win) {
+    s32 prev = nativeSource;
+
+    if (NATIVE_UP) { /* the slot's two boxes: Load / Delete, then Autosave / Saves */
+        s32 tapped = nativeButtonTap();
+
+        if (nativeBackTap()) {
+            tapped = -2;
+        }
+        if (tapped == -2) {
+            SOUND.playSound(SOUND_MENU_CANCEL);
+            nativeStep = nativeStep == 1 ? 0 : -1;
+            saves->substate = nativeStep < 0 ? 2 : 5;
+            nativeShowRows(saves, win);
+            return;
+        }
+        if (tapped < 0) {
+            return;
+        }
+        SOUND.playSound(SOUND_SELECT);
+        if (nativeStep == 0 && tapped == 1) { /* delete: yes or no, no first */
+            nativeStep = 2;
+            saves->substate = 6;
+            nativeShowRows(saves, win);
+            return;
+        }
+        if (nativeStep == 0 && native_autosave_exists(nativeGame)) { /* load: from where */
+            nativeStep = 1;
+            nativeShowRows(saves, win);
+            return;
+        }
+        native_game_select(nativeGame);
+        nativeSel = nativeGame - 1;
+        nativeRestoreWindows(saves, win);
+        if (nativeStep == 0 || tapped == 1) { /* the card's saves */
+            nativeStartCheck(saves, win);
+            return;
+        }
+        nativeAutoListStart(saves, win); /* the two autosaves, in the picker */
+        return;
+    }
+
+    if (NATIVE_UP || nativeListInput(&nativeSource, 2, NULL) == 1) { /* upright: the autosave was picked above */
+        if (nativeSource == 0 || NATIVE_UP) {
+            nativeListText[0] = 0;
+            win->windows[0]->setString(win->windows[0], nativeListText, -1); /* -1: the text itself, 1-byte */
+            if (native_autosave_read(NATIVE_UP ? nativeGame : native_game_number(nativeSel), STGMCARD_funcs.dataBuf)) {
+                /* the autosave, a save as the card has it: loaded as STGMCARD_loadSave does, then its end (500) */
+                SOUND.playSound(SOUND_SELECT);
+                GAME_SAVE = STGMCARD_funcs.dataBuf->save;
+                native_extra_loaded();
+                win->windows[2]->setVisible(win->windows[2], 0);
+                win->windows[3]->setVisible(win->windows[3], 0);
+                win->cursor->setVisible(win->cursor, 0);
+                win->windows[1]->setString(win->windows[1], FILE_CACHE.load(TEXT_FILE(TEXT_MEMORY_CARD)), 0x11);
+                if (win->panel == NULL) {
+                    win->panel = STGMCARD_createPanel(0xCD, 0xC1, 0x62, 0xA);
+                }
+                win->panel->setTopColor(win->panel, 0x7F, 0x32, 0xF2);
+                win->panel->setBottomColor(win->panel, 0xD1, 0x2F, 0xDE);
+                saves->choosing = 0;
+                saves->backToPick = 0;
+                saves->substate = 7; /* the panel fills next frame: a new one resets itself first */
+            } else {
+                nativeStartCheck(saves, win);
+            }
+        } else {
+            nativeStartCheck(saves, win);
+        }
+        return;
+    }
+    if (PAD_PRESSED(PAD_TRIANGLE)) {
+        SOUND.playSound(SOUND_MENU_CANCEL);
+        saves->substate = 2;
+        nativeShowRows(saves, win);
+        return;
+    }
+    if (prev != nativeSource) {
+        nativeListCursor(win, nativeSource);
+    }
+}
+
+/* Deleting a game (held in the list): yes deletes its saves, no or triangle goes back to the list */
+static void nativePickDelete(MemCardSaves *saves, MemCardSavesWindows *win) {
+    s32 prev = nativeSource;
+
+    if (NATIVE_UP) { /* Yes / No side by side: delete the slot, or replace it with the new game */
+        s32 tapped = nativeButtonTap();
+
+        if (nativeBackTap()) {
+            tapped = 1;
+        }
+        if (tapped == 0 && native_replace_is_pending()) {
+            SOUND.playSound(SOUND_SELECT);
+            native_replace_pending(0);
+            native_game_new_at(nativeGame);
+            GAME.funcs.newGame();
+            GAME.funcs.resetPlayTime();
+            BATTLE_SETUP.clearGauges();
+            MEMCARD_FUNCS.setFileName();
+            GAME.funcs.requestMode(MODE_NEW_GAME, 0);
+            saves->substate = 500; /* nothing more here: the new game's mode starts */
+            return;
+        }
+        if (tapped == 0) {
+            SOUND.playSound(SOUND_SELECT);
+            native_game_delete(nativeGame);
+            nativeStep = -1;
+            saves->substate = 2;
+            nativeShowRows(saves, win);
+            return;
+        }
+        if (tapped == 1) {
+            SOUND.playSound(SOUND_MENU_CANCEL);
+            nativeStep = native_replace_is_pending() ? -1 : 0;
+            saves->substate = nativeStep < 0 ? 2 : 5;
+            nativeShowRows(saves, win);
+        }
+        return;
+    }
+
+    if (nativeListInput(&nativeSource, 2, NULL) == 1 || PAD_PRESSED(PAD_TRIANGLE)) {
+        if (nativeSource == 0 && !PAD_PRESSED(PAD_TRIANGLE)) {
+            SOUND.playSound(SOUND_SELECT);
+            native_game_delete(NATIVE_UP ? nativeGame : native_game_number(nativeDelete));
+            nativeSel = nativeTop = 0;
+        } else {
+            SOUND.playSound(SOUND_MENU_CANCEL);
+        }
+        saves->substate = 2;
+        nativeShowRows(saves, win);
+        return;
+    }
+    if (prev != nativeSource) {
+        nativeListCursor(win, nativeSource);
+    }
+}
