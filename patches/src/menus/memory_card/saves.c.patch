+/* 1 when answered (saves->choice the answer): a tap on one, or X */
+static s32 nativeYesNoInput(MemCardSaves *saves, MemCardSavesWindows *win) {
+    s32 tap = nativeYesNoTap(), answered = PAD_PRESSED(PAD_CROSS) != 0;
+
+    if (NATIVE_UP && (PAD_PRESSED(PAD_LEFT) || PAD_PRESSED(PAD_RIGHT))) {
+        saves->choice = PAD_PRESSED(PAD_RIGHT) ? 1 : 0;
+        SOUND.playSound(SOUND_CURSOR);
+    }
+    if (tap >= 0) {
+        saves->choice = tap;
+        answered = 1;
+    }
+    if (answered) {
+        nativeYesNoDone(win);
+        win->cursor->setPos(win->cursor, 0xC2, saves->choice * 14 + 0xBD);
+    }
+    return answered;
+}
