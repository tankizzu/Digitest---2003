+/* The rows: the games from nativeTop (number, day and time made), the autosave / saves choice (substate 5) or the
+   yes / no of a deletion (6) */
+static void nativeShowRows(MemCardSaves *saves, MemCardSavesWindows *win) {
+    s32 count = native_game_count();
+
+    if (NATIVE_UP) {
+        const char *empty = LANGUAGE == 4 ? "vuota" : "empty";
+
+        win->windows[4]->setVisible(win->windows[4], 0);
+        win->windows[3]->setVisible(win->windows[3], 0);
+        win->cursor->setVisible(win->cursor, 0);
+        if (saves->substate == 5 || saves->substate == 6) { /* the choices, one under the other, in the left column */
+            static const s32 YES_NO[2] = {0x16, 0x17};
+
+            win->windows[2]->setVisible(win->windows[2], 0);
+            if (saves->substate == 5) {
+                win->windows[1]->setString(win->windows[1], FILE_CACHE.load(TEXT_FILE(TEXT_MEMORY_CARD)), 0x28);
+                win->windows[1]->setNumber(win->windows[1], 1, nativeGame);
+                nativeListStrings(nativeOpts, nativeOptCount);
+            } else {
+                win->windows[1]->setString(win->windows[1], FILE_CACHE.load(TEXT_FILE(TEXT_MEMORY_CARD)), 0x2C);
+                win->windows[1]->setNumber(win->windows[1], 1, nativeGame);
+                nativeListStrings(YES_NO, 2);
+            }
+            win->windows[0]->setPos(win->windows[0], NATIVE_GRID_X(0) + 0x18, NATIVE_GRID_Y(0));
+            win->windows[0]->setLines(win->windows[0], 10);
+            win->windows[0]->setString(win->windows[0], nativeListText, -1);
+            win->cursor->setVisible(win->cursor, 1);
+            win->cursor->setPos(win->cursor, NATIVE_GRID_X(0) + 6, NATIVE_GRID_Y(nativeSource));
+            return;
+        }
+        win->windows[1]->setString(win->windows[1], FILE_CACHE.load(TEXT_FILE(TEXT_MEMORY_CARD)), 0x1D);
+        native_games_column_text(1, 5, empty, nativeListText, sizeof nativeListText);
+        win->windows[0]->setPos(win->windows[0], NATIVE_GRID_X(0) + NATIVE_TEXT_DX, NATIVE_GRID_Y(0));
+        win->windows[0]->setLines(win->windows[0], 10);
+        win->windows[0]->setString(win->windows[0], nativeListText, -1);
+        native_games_column_text(6, 5, empty, nativeColText, sizeof nativeColText);
+        win->windows[2]->setPos(win->windows[2], NATIVE_GRID_X(5) + NATIVE_TEXT_DX, NATIVE_GRID_Y(5));
+        win->windows[2]->setLines(win->windows[2], 10);
+        win->windows[2]->setString(win->windows[2], nativeColText, -1);
+        return;
+    }
+
+    win->windows[2]->setVisible(win->windows[2], 0);
+    win->windows[3]->setVisible(win->windows[3], 0);
+    if (saves->substate == 5 || saves->substate == 6) {
+        static const s32 SOURCE[2] = {0x2A, 0x2B}, YES_NO[2] = {0x16, 0x17};
+
+        if (saves->substate == 5) {
+            win->windows[1]->setString(win->windows[1], FILE_CACHE.load(TEXT_FILE(TEXT_MEMORY_CARD)), 0x29);
+        } else {
+            win->windows[1]->setString(win->windows[1], FILE_CACHE.load(TEXT_FILE(TEXT_MEMORY_CARD)), 0x2C);
+            win->windows[1]->setNumber(win->windows[1], 1, native_game_number(nativeDelete));
+        }
+        nativeListStrings(saves->substate == 5 ? SOURCE : YES_NO, 2);
+        win->windows[0]->setString(win->windows[0], nativeListText, -1); /* -1: the text itself, 1-byte */
+        nativeListCursor(win, nativeSource);
+        return;
+    }
+    if (count == 0) {
+        win->windows[1]->setString(win->windows[1], FILE_CACHE.load(TEXT_FILE(TEXT_MEMORY_CARD)), 0x0A);
+        nativeListText[0] = 0;
+        win->windows[0]->setString(win->windows[0], nativeListText, -1); /* -1: the text itself, 1-byte */
+        win->cursor->setVisible(win->cursor, 0);
+        return;
+    }
+    win->windows[1]->setString(win->windows[1], FILE_CACHE.load(TEXT_FILE(TEXT_MEMORY_CARD)), 0x1D);
+    native_games_list_text(nativeTop, NATIVE_LIST_ROWS, nativeListText, sizeof nativeListText);
+    win->windows[0]->setString(win->windows[0], nativeListText, -1); /* -1: the text itself, 1-byte */
+    nativeListCursor(win, nativeSel - nativeTop);
+}
+
+/* The list's input: a finger dragged on it scrolls it (top, when it scrolls), a tap picks a row (1), a finger held
+   on a row asks for its own choice (2); up, down and X as on the pad. The row in *sel */
+static s32 nativeListInput(s32 *sel, s32 count, s32 *top) {
+    s32 ev, ty, dy, row, prev = *sel, base;
+
+    native_touch_list(NATIVE_LIST_X, NATIVE_LIST_Y - 6, 0x128, NATIVE_LIST_ROWS * NATIVE_LIST_PITCH);
+    native_touch_in_menu();
+    ev = native_touch_list_event(&ty, &dy);
+    if (top != NULL) {
+        nativeScroll += dy;
+        while (nativeScroll <= -NATIVE_LIST_PITCH / 2 && *top + NATIVE_LIST_ROWS < count) {
+            (*top)++, nativeScroll += NATIVE_LIST_PITCH;
+        }
+        while (nativeScroll >= NATIVE_LIST_PITCH / 2 && *top > 0) {
+            (*top)--, nativeScroll -= NATIVE_LIST_PITCH;
+        }
+        /* at an end only the way that is blocked is dropped: the other gathers until it moves a row */
+        if ((*top == 0 && nativeScroll > 0) || (*top + NATIVE_LIST_ROWS >= count && nativeScroll < 0)) {
+            nativeScroll = 0;
+        }
+        if (*sel < *top) {
+            *sel = *top;
+        } else if (*sel > *top + NATIVE_LIST_ROWS - 1) {
+            *sel = *top + NATIVE_LIST_ROWS - 1;
+        }
+    }
+    base = top != NULL ? *top : 0;
+    if (ev != 0) {
+        row = (ty - (NATIVE_LIST_Y - 6)) / NATIVE_LIST_PITCH;
+        if (row >= 0 && row < NATIVE_LIST_ROWS && base + row < count) {
+            *sel = base + row;
+            return ev;
+        }
+    }
+    if ((PAD_PRESSED(PAD_UP) || PAD_REPEATED(PAD_UP)) && *sel > 0) {
+        (*sel)--;
+    } else if ((PAD_PRESSED(PAD_DOWN) || PAD_REPEATED(PAD_DOWN)) && *sel < count - 1) {
+        (*sel)++;
+    }
+    if (top != NULL) {
+        if (*sel < *top) {
+            *top = *sel;
+        } else if (*sel > *top + NATIVE_LIST_ROWS - 1) {
+            *top = *sel - NATIVE_LIST_ROWS + 1;
+        }
+    }
+    if (prev != *sel) {
+        SOUND.playSound(SOUND_CURSOR);
+    }
+    return (PAD.getPressed(0) & (1 << PAD_CROSS)) != 0;
+}
+
+/* Up, down and a tap on a row: 1 when a row is picked (by X or the tap), the row's index in *row */
+static s32 nativeRowInput(s32 *sel, s32 count, s32 *top) {
+    s32 tapped, prev = *sel;
+
+    native_touch_target(0, 0xB8, 0xBA, 0x80, 14);
+    if (count > 1) {
+        native_touch_target(1, 0xB8, 0xBA + 14, 0x80, 14);
+    }
+    native_touch_in_menu();
+    tapped = native_touch_tap();
+    if (tapped >= 0) {
+        *sel = (top != NULL ? *top : 0) + tapped;
+        return 1;
+    }
+    if ((PAD_PRESSED(PAD_UP) || PAD_REPEATED(PAD_UP)) && *sel > 0) {
+        (*sel)--;
+    } else if ((PAD_PRESSED(PAD_DOWN) || PAD_REPEATED(PAD_DOWN)) && *sel < count - 1) {
+        (*sel)++;
+    }
+    if (top != NULL) {
+        if (*sel < *top) {
+            *top = *sel;
+        } else if (*sel > *top + 1) {
+            *top = *sel - 1;
+        }
+    }
+    if (prev != *sel) {
+        SOUND.playSound(SOUND_CURSOR);
+    }
+    return (PAD.getPressed(0) & (1 << PAD_CROSS)) != 0;
+}
+
+/* The game picked (or, saving, the one being played): its card is the one the screen reads from now on, as port 0 */
+static void nativeStartCheck(MemCardSaves *saves, MemCardSavesWindows *win) {
+    saves->port = 0;
+    win->windows[0]->setString(win->windows[0], FILE_CACHE.load(TEXT_FILE(TEXT_MEMORY_CARD)), 4);
+    STGMCARD_showPort(saves, win, 1);
+    win->windows[1]->setVisible(win->windows[1], 0);
+    win->windows[2]->setVisible(win->windows[2], 0);
+    win->windows[3]->setVisible(win->windows[3], 0);
+    win->cursor->setVisible(win->cursor, 0);
+    if (win->panel == NULL) {
+        win->panel = STGMCARD_createPanel(0xCD, 0xC1, 0x62, 0xA);
+    }
+    win->panel->setTopColor(win->panel, 0x7F, 0x32, 0xF2);
+    win->panel->setBottomColor(win->panel, 0xD1, 0x2F, 0xDE);
+    saves->substate = 10;
+    SOUND.playSound(SOUND_SELECT);
+    saves->choosing = 0;
+}
+
+static void nativeLeave(MemCardSaves *saves) {
+    SOUND.playSound(SOUND_MENU_CANCEL);
+    saves->hide(saves);
+    saves->choosing = 0;
+    saves->screen->step = 1;
+}
+
+/* Upright: the slot picked; its choices: its autosave (if any), its saves (if any), its deletion */
+static void nativeOpenSlot(MemCardSaves *saves, MemCardSavesWindows *win) {
+    nativeGame = nativeSel + 1;
+    nativeOptCount = 0;
+    if (native_autosave_exists(nativeGame)) {
+        nativeOpts[nativeOptCount++] = 0x2A;
+    }
+    nativeOpts[nativeOptCount++] = 0x2B;
+    nativeOpts[nativeOptCount++] = 0x2D;
+    nativeSource = 0;
+    saves->substate = 5;
+    SOUND.playSound(SOUND_SELECT);
+    nativeShowRows(saves, win);
+}
+
+static void nativePickSlot(MemCardSaves *saves, MemCardSavesWindows *win) {
+    s32 i, prev = nativeSel, tapped = -1;
+
+    native_touch_in_menu();
+    for (i = 0; i < NATIVE_SLOTS; i++) {
+        native_touch_target(0x7A60 + i, NATIVE_GRID_X(i) - 6, NATIVE_GRID_Y(i) - 4, 0x92, 28);
+    }
+    for (i = 0; i < NATIVE_SLOTS; i++) {
+        if (native_touch_tap_id(0x7A60 + i)) {
+            tapped = i;
+        }
+    }
+    if (PAD_PRESSED(PAD_UP) && nativeSel % 5 > 0) {
+        nativeSel--;
+    } else if (PAD_PRESSED(PAD_DOWN) && nativeSel % 5 < 4) {
+        nativeSel++;
+    } else if (PAD_PRESSED(PAD_LEFT) && nativeSel >= 5) {
+        nativeSel -= 5;
+    } else if (PAD_PRESSED(PAD_RIGHT) && nativeSel < 5) {
+        nativeSel += 5;
+    }
+    if (tapped >= 0) {
+        nativeSel = tapped;
+    }
+    if (prev != nativeSel) {
+        SOUND.playSound(SOUND_CURSOR);
+    }
+    if (tapped >= 0 || PAD_PRESSED(PAD_CROSS)) {
+        if (native_game_exists(nativeSel + 1)) {
+            nativeOpenSlot(saves, win);
+        } else {
+            SOUND.playSound(SOUND_MENU_CANCEL); /* an empty slot: nothing to load */
+        }
+    } else if (PAD_PRESSED(PAD_TRIANGLE)) {
+        nativeLeave(saves);
+    }
+}
+
+/* The games: X or a tap picks one; triangle leaves */
+static void nativePickGame(MemCardSaves *saves, MemCardSavesWindows *win) {
+    s32 count = native_game_count(), prevTop = nativeTop, prevSel = nativeSel, game;
+
+    if (saves->screen->loading == 0) { /* saving: the game being played, without asking */
+        if (native_game_current() == 0) {
+            native_game_new();
+        }
+        nativeStartCheck(saves, win);
+        return;
+    }
+    if (NATIVE_UP) {
+        nativePickSlot(saves, win);
+        return;
+    }
+    if (count == 0) {
+        native_touch_in_menu();
+        if (MC_CROSS() || PAD_PRESSED(PAD_TRIANGLE) || native_touch_anywhere()) {
+            nativeLeave(saves);
+        }
+        return;
+    }
+    switch (nativeListInput(&nativeSel, count, &nativeTop)) {
+    case 0:
+        break;
+    case 2: /* held: delete it? */
+        SOUND.playSound(SOUND_SELECT);
+        nativeDelete = nativeSel;
+        nativeSource = 1; /* no, to start with */
+        saves->substate = 6;
+        nativeShowRows(saves, win);
+        return;
+    default:
+        game = native_game_number(nativeSel);
+        native_game_select(game);
+        if (native_autosave_exists(game)) {
+            SOUND.playSound(SOUND_SELECT);
+            nativeSource = 0;
+            saves->substate = 5;
+            nativeShowRows(saves, win);
+        } else {
+            nativeStartCheck(saves, win);
+        }
+        return;
+    }
+    if (PAD_PRESSED(PAD_TRIANGLE)) {
+        nativeLeave(saves);
+        return;
+    }
+    if (prevTop != nativeTop || prevSel != nativeSel) {
+        nativeShowRows(saves, win);
+    }
+}
+
+/* Where to continue the game from: its autosave (loaded at the frame's end, platform/state.c) or its saves */
+static void nativePickSource(MemCardSaves *saves, MemCardSavesWindows *win) {
+    s32 prev = nativeSource;
+
+    if (NATIVE_UP) { /* the slot's choices: autosave, saves, delete */
+        if (nativeListInput(&nativeSource, nativeOptCount, NULL) == 1) {
+            switch (nativeOpts[nativeSource]) {
+            case 0x2D:
+                SOUND.playSound(SOUND_SELECT);
+                nativeSource = 1; /* no, to start with */
+                saves->substate = 6;
+                nativeShowRows(saves, win);
+                return;
+            case 0x2B:
+                native_game_select(nativeGame);
+                win->windows[0]->setPos(win->windows[0], saves->origin[0] + 15, saves->origin[1] + 40);
+                win->windows[0]->setLines(win->windows[0], 5);
+                nativeStartCheck(saves, win);
+                return;
+            }
+            native_game_select(nativeGame); /* the autosave, as below */
+            nativeSel = nativeGame - 1;
+        } else if (PAD_PRESSED(PAD_TRIANGLE)) {
+            SOUND.playSound(SOUND_MENU_CANCEL);
+            saves->substate = 2;
+            nativeShowRows(saves, win);
+            return;
+        } else {
+            if (prev != nativeSource) {
+                nativeListCursor(win, nativeSource);
+            }
+            return;
+        }
+    }
+
+    if (NATIVE_UP || nativeListInput(&nativeSource, 2, NULL) == 1) { /* upright: the autosave was picked above */
+        if (nativeSource == 0 || NATIVE_UP) {
+            nativeListText[0] = 0;
+            win->windows[0]->setString(win->windows[0], nativeListText, -1); /* -1: the text itself, 1-byte */
+            if (native_autosave_read(NATIVE_UP ? nativeGame : native_game_number(nativeSel), STGMCARD_funcs.dataBuf)) {
+                /* the autosave, a save as the card has it: loaded as STGMCARD_loadSave does, then its end (500) */
+                SOUND.playSound(SOUND_SELECT);
+                GAME_SAVE = STGMCARD_funcs.dataBuf->save;
+                native_extra_loaded();
+                win->windows[2]->setVisible(win->windows[2], 0);
+                win->windows[3]->setVisible(win->windows[3], 0);
+                win->cursor->setVisible(win->cursor, 0);
+                win->windows[1]->setString(win->windows[1], FILE_CACHE.load(TEXT_FILE(TEXT_MEMORY_CARD)), 0x11);
+                if (win->panel == NULL) {
+                    win->panel = STGMCARD_createPanel(0xCD, 0xC1, 0x62, 0xA);
+                }
+                win->panel->setTopColor(win->panel, 0x7F, 0x32, 0xF2);
+                win->panel->setBottomColor(win->panel, 0xD1, 0x2F, 0xDE);
+                saves->choosing = 0;
+                saves->backToPick = 0;
+                saves->substate = 7; /* the panel fills next frame: a new one resets itself first */
+            } else {
+                nativeStartCheck(saves, win);
+            }
+        } else {
+            nativeStartCheck(saves, win);
+        }
+        return;
+    }
+    if (PAD_PRESSED(PAD_TRIANGLE)) {
+        SOUND.playSound(SOUND_MENU_CANCEL);
+        saves->substate = 2;
+        nativeShowRows(saves, win);
+        return;
+    }
+    if (prev != nativeSource) {
+        nativeListCursor(win, nativeSource);
+    }
+}
+
+/* Deleting a game (held in the list): yes deletes its saves, no or triangle goes back to the list */
+static void nativePickDelete(MemCardSaves *saves, MemCardSavesWindows *win) {
+    s32 prev = nativeSource;
+
+    if (nativeListInput(&nativeSource, 2, NULL) == 1 || PAD_PRESSED(PAD_TRIANGLE)) {
+        if (nativeSource == 0 && !PAD_PRESSED(PAD_TRIANGLE)) {
+            SOUND.playSound(SOUND_SELECT);
+            native_game_delete(NATIVE_UP ? nativeGame : native_game_number(nativeDelete));
+            nativeSel = nativeTop = 0;
+        } else {
+            SOUND.playSound(SOUND_MENU_CANCEL);
+        }
+        saves->substate = 2;
+        nativeShowRows(saves, win);
+        return;
+    }
+    if (prev != nativeSource) {
+        nativeListCursor(win, nativeSource);
+    }
+}
