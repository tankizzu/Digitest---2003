+#ifdef NATIVE
+/* The games (platform/games.c) instead of the ports: the rows list them two at a time, from nativeTop; the pick is
+   nativeSel. Loading a game with an autosave asks first where from (substate 5) */
+/* The rows: games nativeTop and nativeTop + 1 (their numbers), or the autosave / saves choice */
