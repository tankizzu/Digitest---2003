+/* Upright: the box tapped (0 left, 1 right), else -1 */
+static s32 nativeButtonTap(void) {
+    s32 i;
+
+    for (i = 0; i < 2; i++) {
+        native_touch_target(0x7A70 + i, NATIVE_BTN_X(i) - 4, NATIVE_BTN_Y - 6, NATIVE_BTN_W + 8, NATIVE_BTN_H + 12);
+    }
+    for (i = 0; i < 2; i++) {
+        if (native_touch_tap_id(0x7A70 + i)) {
+            return i;
+        }
+    }
+    return -1;
+}
