+/* An autosave's details as the card's info section has a save's (STGMCARD_fillSave), from its data: the area and
+   place the field's banner shows (as a menu save's, screen.c) */
+extern struct NativeAreaName {
+    u8 area;
+    u8 place;
+    s16 mode;
+} FIELDSTG_areaNames[];
+
+static void nativeFillInfo(MemCardSave *save, SaveData *data) {
+    s32 i, member;
+
+    strcpy((char *)save->name, data->game.name);
+    for (i = 0; FIELDSTG_areaNames[i].mode != 0; i++) {
+        if (FIELDSTG_areaNames[i].mode == data->game.fieldMode) {
+            save->area = FIELDSTG_areaNames[i].area;
+            save->place = 0x100 | FIELDSTG_areaNames[i].place;
+        }
+    }
+    save->money = data->game.money;
+    save->time = data->game.playTime;
+    for (i = 0; i < 3; i++) {
+        member = data->game.party[i];
+        if (member >= 0 && member < PARTNER_COUNT) {
+            save->levels[i] = data->game.partners[member].info.stats[STAT_LEVEL];
+            save->partners[i] = data->game.partners[member].unlocked;
+        } else {
+            save->partners[i] = 3; /* no partner there yet: the first one's picture, as no save of the game has it */
+        }
+    }
+}
