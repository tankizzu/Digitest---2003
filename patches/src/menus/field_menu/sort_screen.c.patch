 /* Draws the cursors, the partners' portraits and frames, the two being
    swapped squashed by the fade, and the swap's arrow */
+#ifdef NATIVE
+/* Upright, for the finger: the partners' panels big at the top as in the item screen (item_screen.c), the swap's
+   arrows beside them, the title under them, the help at the bottom (gpu_draw.c's layout) */
+static void nativeSortLayout(SortScreen *screen) {
+    s32 i;
+
+    for (i = 0; i < screen->count; i++) {
+        if (screen->pageFades[i].level != 0) {
+            NATIVE_MENU_PIECE(screen->layer, 0, 15 + i * 46, 150, 48, 0, 24 + i * 68, 210, 67);
+        }
+    }
+    if (screen->arrowShown) {
+        NATIVE_MENU_PIECE(screen->layer, 145, 30, 30, 123, 203, 46, 42, 182); /* the swap's arrows, under the title */
+    }
+    if (screen->fades[0].level != 0) {
+        NATIVE_MENU_PIECE(screen->layer, 30, 10, 290, 28, -54, 232, 348, 34); /* the title */
+    }
+    if (screen->fades[1].level != 0) {
+        NATIVE_MENU_PIECE(screen->layer, 0, 190, 320, 48, 0, 572, 320, 48); /* the help */
+    }
+}
+
+/* Upright, the finger on the partners' panels (nativeSortLayout): the one tapped, -1 if none */
+static s32 nativeSortTap(SortScreen *screen) {
+    s32 top = (native_field_h() - SCREEN_HEIGHT) / 2, m;
+
+    for (m = 0; m < screen->count; m++) {
+        native_touch_target(m, 0, 24 + m * 68 - top, 210, 67);
+    }
+    return native_touch_tap();
+}
+#endif
+
 void STSTATUS_drawSortScreen(SortScreen *screen) {
     SpriteDrawer sprite;
     s32 id;
     s32 i;
 
+#ifdef NATIVE
+    if (native_portrait()) {
+        nativeSortLayout(screen);
+    }
+#endif
     initSpriteDrawer(&sprite);
     sprite.setLayerId(screen->layer, screen->depth);
     STSTATUS_stepSortCursor(screen);
