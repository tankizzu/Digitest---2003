 /* Draws the partners' portraits and frames, the chosen one's, its equipment
    and the panels' frames */
+#ifdef NATIVE
+/* Upright, for the finger: the partners' panels as in the item screen (item_screen.c); once one is chosen, its panel
+   at the top with the EXP and the TP beside it, the two choices (digivolutions, equipment) big under it, the stats,
+   then the digivolutions' and the equipment's panels bigger (gpu_draw.c's layout) */
+#define NATIVE_STATUS_CHOICE_Y 100
+#define NATIVE_STATUS_CHOICE_K 183 /* hundredths */
+static void nativeStatusLayout(StatsScreen *screen) {
+    s32 i;
+
+    for (i = 0; i < screen->count; i++) {
+        if (screen->pageFades[i].level != 0) {
+            NATIVE_MENU_PIECE(screen->layer, 0, 15 + i * 46, 150, 48, 0, 24 + i * 68, 210, 67);
+        }
+    }
+    if (screen->panelFades[0].level != 0) {
+        NATIVE_MENU_PIECE(screen->layer, 0, 15, 150, 48, 0, 24, 210, 67); /* the chosen partner */
+    }
+    if (screen->fades[0].level != 0) {
+        NATIVE_MENU_PIECE(screen->layer, 30, 10, 290, 28, -54, 232, 348, 34); /* the title */
+    }
+    if (screen->panelFades[5].level != 0) {
+        NATIVE_MENU_PIECE(screen->layer, 0, 58, 112, 24, 212, 30, 108, 23); /* the EXP */
+    }
+    if (screen->panelFades[1].level != 0) { /* the choices */
+        NATIVE_MENU_PIECE(screen->layer, 145, 12, 185, 40, 0, NATIVE_STATUS_CHOICE_Y, 185 * NATIVE_STATUS_CHOICE_K / 100,
+                          40 * NATIVE_STATUS_CHOICE_K / 100);
+    }
+    if (screen->panelFades[2].level != 0) {
+        NATIVE_MENU_PIECE(screen->layer, 0, 82, 112, 112, 0, 180, 157, 157); /* the stats */
+        if (!screen->unk70) { /* else the equipment's help covers it (equip_panel.c) */
+            NATIVE_MENU_PIECE(screen->layer, 0, 192, 80, 30, 212, 60, 80, 30); /* the TP */
+        }
+    }
+    if (screen->panelFades[3].level != 0) {
+        NATIVE_MENU_PIECE(screen->layer, 156, 46, 176, 72, -3, 339, 264, 108); /* the digivolutions */
+    }
+    if (screen->panelFades[4].level != 0) {
+        NATIVE_MENU_PIECE(screen->layer, 156, 112, 176, 114, -3, 446, 264, 171); /* the equipment */
+    }
+    if (screen->fades[1].level != 0) {
+        NATIVE_MENU_PIECE(screen->layer, 0, 190, 320, 48, 0, 616, 320, 48); /* the help */
+    }
+}
+#endif
