+#ifdef NATIVE
+/* Upright, for the finger, under the status screen's stats (status_screen.c): the title and the six slots big; then
+   the slot's item, the list of the items that fit it big, the help at the bottom (gpu_draw.c's layout) */
+#define NATIVE_EQUIP_Y 345
+#define NATIVE_EQUIP_SLOTS_Y (NATIVE_EQUIP_Y + 38)
+#define NATIVE_EQUIP_LIST_Y (NATIVE_EQUIP_Y + 58)
+static void nativeEquipLayout(EquipPanel *panel) {
+    if (panel->panels[0].level != 0) {
+        NATIVE_MENU_PIECE(panel->layer, 30, 10, 290, 28, -54, NATIVE_EQUIP_Y, 348, 34); /* the title */
+    }
+    if (panel->panels[1].level != 0) { /* the slots, 1.8 times */
+        NATIVE_MENU_PIECE(panel->layer, 150, 36, 180, 104, 14, NATIVE_EQUIP_SLOTS_Y, 324, 187);
+    }
+    if (panel->panels[3].level != 0) { /* the slot's item, 1.5 times */
+        NATIVE_MENU_PIECE(panel->layer, 150, 8, 180, 44, 65, NATIVE_EQUIP_Y - 3, 270, 66);
+    }
+    if (panel->panels[2].level != 0) { /* the list, 1.5 times, and the help */
+        NATIVE_MENU_PIECE(panel->layer, 110, 52, 220, 138, 5, NATIVE_EQUIP_LIST_Y, 330, 207);
+        NATIVE_MENU_PIECE(panel->layer, 0, 190, 320, 48, 0, 616, 320, 48);
+    }
+    /* the help covers the status screen's TP, as on the PlayStation: that screen leaves it to this help's piece */
+    panel->screen->unk70 = panel->panels[2].level != 0;
+}
+
+/* Upright, the finger on the slots (nativeEquipLayout): the one tapped, -1 if none */
+static s32 nativeEquipSlotTap(void) {
+    s32 top = (native_field_h() - SCREEN_HEIGHT) / 2, i;
+
+    for (i = 0; i < 6; i++) {
+        native_touch_target(i, 14, NATIVE_EQUIP_SLOTS_Y + (10 + i * 14) * 18 / 10 - top, 306, 25);
+    }
+    return native_touch_tap();
+}
+
+/* Upright, the finger on the list (nativeEquipLayout): a row (0-7), 8 the arrow up, 9 the arrow down, -1 if none */
+static s32 nativeEquipListTap(EquipPanel *panel) {
+    s32 top = (native_field_h() - SCREEN_HEIGHT) / 2, i;
+
+    for (i = 0; i < 8 && panel->scroll + i < panel->count; i++) {
+        native_touch_target(i, 13, NATIVE_EQUIP_LIST_Y + (21 + i * 14) * 3 / 2 - top, 262, 21);
+    }
+    if (panel->count > 8) {
+        native_touch_target(8, 275, NATIVE_EQUIP_LIST_Y - top, 45, 40);
+        native_touch_target(9, 275, NATIVE_EQUIP_LIST_Y + 164 - top, 45, 40);
+    }
+    return native_touch_tap();
+}
+#endif
