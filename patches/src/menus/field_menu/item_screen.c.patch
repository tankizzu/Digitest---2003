 /* Draws the partners' portraits and frames, the item, the cursor and the help arrow */
+#ifdef NATIVE
+/* Upright, for the finger: the partners' panels big at the top (to tap the one an item goes to), the title under them,
+   the categories big (rows to tap), the BIT, the chosen item and the help at the bottom, as the item list has them
+   (item_list.c); gpu_draw.c's layout */
+static void nativeItemScreenLayout(ItemScreen *screen) {
+    s32 i;
+
+    for (i = 0; i < screen->count; i++) {
+        if (screen->pageFades[i].level != 0) {
+            NATIVE_MENU_PIECE(screen->layer, 0, 15 + i * 46, 150, 48, 0, 24 + i * 68, 210, 67);
+        }
+    }
+    if (screen->fades[0].level != 0) {
+        NATIVE_MENU_PIECE(screen->layer, 30, 10, 290, 28, -54, 232, 348, 34); /* the title */
+    }
+    if (screen->fades2[0].level != 0) {
+        NATIVE_MENU_PIECE(screen->layer, 166, 38, 154, 86, 1, 268, 354, 198); /* the categories */
+    }
+    if (screen->fades2[1].level != 0) {
+        NATIVE_MENU_PIECE(screen->layer, 0, 155, 112, 24, 0, 474, 112, 24); /* the BIT */
+    }
+    if (screen->fade.level != 0) {
+        NATIVE_MENU_PIECE(screen->layer, 8, 160, 316, 36, 6, 534, 316, 36); /* the chosen item */
+    }
+    if (screen->fades[1].level != 0) {
+        NATIVE_MENU_PIECE(screen->layer, 0, 190, 320, 48, 0, 572, 320, 48); /* the help */
+    }
+}
+#endif
