 /* Draws the panel's frames, the technique icons and the help arrow */
+#ifdef NATIVE
+/* Upright, for the finger, under the chosen partner's panel (status_screen.c): the title, the three slots (or the
+   question about one) 1.8 times, the stats 1.23 times across the screen, the help at the bottom (gpu_draw.c) */
+#define NATIVE_DV_SLOTS_Y 140
+#define NATIVE_DV_STATS_Y 262
+#define NATIVE_DV_SLOT_ROW(i) (NATIVE_DV_SLOTS_Y + (9 + (i) * 14) * 18 / 10)    /* a slot's row, 25 high */
+#define NATIVE_DV_OPTION_ROW(i) (NATIVE_DV_SLOTS_Y + (18 + (i) * 14) * 18 / 10) /* a question's answer */
+static void nativeDigivolveLayout(DigivolvePanel *panel) {
+    if (panel->fades[0].level != 0) {
+        NATIVE_MENU_PIECE(panel->layer, 30, 10, 290, 28, -54, 100, 348, 34); /* the title */
+    }
+    if (panel->fades[1].level != 0 || panel->fades[2].level != 0) { /* the slots, or the question */
+        NATIVE_MENU_PIECE(panel->layer, 160, 36, 170, 64, 14, NATIVE_DV_SLOTS_Y, 306, 115);
+    }
+    if (panel->fades[3].level != 0) { /* the stats, scrolled up for the techniques too */
+        NATIVE_MENU_PIECE(panel->layer, 60, 55, 260, 170, 0, NATIVE_DV_STATS_Y, 320, 209);
+    }
+    if (panel->fades[4].level != 0) {
+        NATIVE_MENU_PIECE(panel->layer, 0, 190, 320, 48, 0, 616, 320, 48); /* the help */
+    }
+}
+
+/* Upright, the finger: the target tapped (native_touch_target ids), -1 if none */
+static s32 nativeDigivolveTap(void) {
+    return native_touch_tap();
+}
+
+#define NATIVE_DV_TARGET(id, y, h) native_touch_target((id), 14, (y) - (native_field_h() - SCREEN_HEIGHT) / 2, 306, (h))
+#endif
