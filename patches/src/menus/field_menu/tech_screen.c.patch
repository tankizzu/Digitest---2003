 /* Draws the partners' portraits and frames, the cursors and the help arrow */
+#ifdef NATIVE
+/* Upright, for the finger, in the middle of the screen as Sort (sort_screen.c): the title, the partners' panels big,
+   under them the technique list 1.4 times, the help (gpu_draw.c's layout) */
+#define NATIVE_TECH_X 55 /* the panels (210 wide) in the middle across */
+static s32 nativeTechTop(void) {
+    return (native_field_h() - 510) / 2; /* title 34, 8, panels 204, 8, list 200, 8, help 48 */
+}
+#define NATIVE_TECH_LIST_Y (nativeTechTop() + 254)
+
+static void nativeTechLayout(TechScreen *screen) {
+    s32 top = nativeTechTop(), i;
+
+    for (i = 0; i < screen->count; i++) {
+        if (screen->pageFades[i].level != 0) {
+            NATIVE_MENU_PIECE(screen->layer, 0, 15 + i * 46, 150, 48, NATIVE_TECH_X, top + 42 + i * 68, 210, 67);
+        }
+    }
+    if (screen->fades[0].level != 0) {
+        NATIVE_MENU_PIECE(screen->layer, 30, 10, 290, 28, -54, top, 348, 34); /* the title */
+    }
+    if (screen->fade.level != 0) { /* the technique list */
+        NATIVE_MENU_PIECE(screen->layer, 140, 40, 180, 145, 34, NATIVE_TECH_LIST_Y, 252, 203);
+    }
+    if (screen->fades[1].level != 0) {
+        NATIVE_MENU_PIECE(screen->layer, 0, 190, 320, 48, 0, top + 462, 320, 48); /* the help */
+    }
+}
+
+/* Upright, the finger on the partners' panels (nativeTechLayout): the one tapped, -1 if none */
+static s32 nativeTechMemberTap(TechScreen *screen) {
+    s32 top = (native_field_h() - SCREEN_HEIGHT) / 2, m;
+
+    for (m = 0; m < screen->count; m++) {
+        native_touch_target(m, NATIVE_TECH_X, nativeTechTop() + 42 + m * 68 - top, 210, 67);
+    }
+    return native_touch_tap();
+}
+
+/* Upright, the finger on the technique list: the row tapped, -1 if none */
+static s32 nativeTechRowTap(TechScreen *screen) {
+    s32 top = (native_field_h() - SCREEN_HEIGHT) / 2, r;
+
+    for (r = 0; r < screen->rows[screen->member].techCount; r++) {
+        native_touch_target(r, 34, NATIVE_TECH_LIST_Y + (22 + r * 14) * 14 / 10 - top, 252, 20);
+    }
+    return native_touch_tap();
+}
+#endif
