 /* Draws the screen: the panels, the party's sprites and the sign */
+#ifdef NATIVE
+/* Upright, for the finger, as the lab (digimon_lab/slot_screen.c): the partner, its stats and TP 1.3 times, the
+   prompt, the party's capsules 1.75 times; the help naming a PlayStation button hidden (gpu_draw.c's layout) */
+#define NATIVE_GYM_PARTY_Y 435
+static void nativeGymLayout(TrainScreen *screen) {
+    if (screen->panels[0].level != 0) {
+        NATIVE_MENU_PIECE(screen->layerId, 0, 7, 146, 70, 0, 92, 219, 105); /* the partner */
+    }
+    if (screen->panels[1].level != 0 || screen->panels[2].level != 0) {
+        NATIVE_MENU_PIECE(screen->layerId, 0, 70, 146, 145, 0, 200, 190, 188); /* its stats and TP */
+    }
+    if (screen->panels[3].level != 0) {
+        NATIVE_MENU_HIDE(screen->layerId, 136, 4, 194, 46);
+    }
+    if (screen->panels[4].level != 0) {
+        NATIVE_MENU_PIECE(screen->layerId, 140, 62, 185, 24, 60, NATIVE_GYM_PARTY_Y - 40, 259, 34);
+    }
+    if (screen->panels[5].level != 0 || screen->panels[6].level != 0) {
+        NATIVE_MENU_PIECE(screen->layerId, 140, 92, 180, 90, 5, NATIVE_GYM_PARTY_Y, 315, 158);
+    }
+}
+#endif
