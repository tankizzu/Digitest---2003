+    NATIVE_MENU_PIECE(session->layerId, 125, 8, 200, 175, 0, NATIVE_GYM_SESSION_Y, 320, 280);
+    /* the training's message panel at the bottom (result.c), 1.2 times under the training */
+    NATIVE_MENU_PIECE(session->layerId, 65, 184, 262, 44, 3, NATIVE_GYM_SESSION_Y + 264, 314, 53);
+}
+#endif
+
