+#ifdef NATIVE
+/* Upright (portrait.c): the menu bigger and lower, there being room: each sprite NATIVE_MENU_SCALE times as big
+   about the screen's middle, its row moved down (NATIVE_MENU_Y) */
+#define NATIVE_MENU_SCALE (ONE * 8 / 5)
+#define NATIVE_MENU_Y(y) ((y) + 70 + ((y) - 154) * 3 / 2)
+static void nativeMenuDraw(SpriteDrawer *sprite, s32 frame, s32 x, s32 y) {
+    if (native_portrait()) {
+        sprite->setScale(NATIVE_MENU_SCALE, NATIVE_MENU_SCALE, ONE);
+        sprite->setPivot(SCREEN_WIDTH / 2, NATIVE_MENU_Y(y) + 8);
+        y = NATIVE_MENU_Y(y);
+    }
+    sprite->draw(FILE_CACHE.getEntry(STDWTITL_spriteBank), frame, x, y);
+}
+
+/* The settings button, drawn with the game's own graphics (the menu sprites, resident in VRAM at 0x140, 0 from the
+   start): the cog of the "machine" icons (frame 0x30), in the menus' small panel (0x16) unless the look says alone;
+   top right inside the phone's safe area, or under the menu (look 3, upright). Returns 1 when tapped */
+#define NATIVE_SETTINGS_ID 0x7A7C
+#define NATIVE_SETTINGS_COG 0x30
+#define NATIVE_SETTINGS_PANEL 0x16
+#define NATIVE_SETTINGS_PANEL_W 44
+static s32 nativeSettingsTapped(TitleMenuTask *task) {
+    SpriteDrawer sprite;
+    s32 look = native_settings_look();
+    s32 top = native_portrait() ? -(native_field_h() - SCREEN_HEIGHT) / 2 : 0;
+    s32 size = look == 1 ? 36 : NATIVE_SETTINGS_PANEL_W;
+    s32 x;
+    s32 y;
+    s32 cog;
+
+    if (look == 3 && native_portrait()) {
+        x = (SCREEN_WIDTH - size) / 2;
+        y = NATIVE_MENU_Y(174) + 40;
+    } else {
+        x = SCREEN_WIDTH - 10 - size - native_touch_safe_inset(2);
+        y = top + 10 + native_touch_safe_inset(1);
+    }
+    initSpriteDrawer(&sprite);
+    sprite.setLayerId(task->layerId, 0);
+    sprite.setTexture(0x140, 0);
+    /* the cog first: at one depth what is added later is drawn under */
+    cog = look == 1 ? 36 : 30; /* the 12-pixel cog, three or two and a half times as big */
+    sprite.setScale(ONE * cog / 12, ONE * cog / 12, ONE);
+    sprite.setPivot(x + (size - cog) / 2, y + (size - cog) / 2);
+    sprite.draw(FILE_CACHE.getEntry(FILE_MENU_SPRITES << 16), NATIVE_SETTINGS_COG, x + (size - cog) / 2, y + (size - cog) / 2);
+    sprite.setScale(ONE, ONE, ONE);
+    if (look != 1) {
+        sprite.draw(FILE_CACHE.getEntry(FILE_MENU_SPRITES << 16), NATIVE_SETTINGS_PANEL, x, y);
+    }
+    native_touch_target(NATIVE_SETTINGS_ID, x - 6, y - 6, size + 12, size + 12);
+    return native_touch_tap_id(NATIVE_SETTINGS_ID);
+}
+#endif
