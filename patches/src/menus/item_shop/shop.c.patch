 /* Draws the shop's four frames as they open by scaling, and the background,
    which scrolls one pixel every other frame, wrapping at 96 */
+#ifdef NATIVE
+/* Upright, for the finger: Buy and Sell twice as big under the title; the help (a PlayStation button's "Back") hidden:
+   the port's back button does it (gpu_draw.c's layout) */
+#define NATIVE_SHOP_Y 300
+static void nativeShopLayout(ItemShop *shop) {
+    if (shop->panels[2].level != 0) {
+        NATIVE_MENU_PIECE(shop->layer, 160, 30, 165, 46, 0, NATIVE_SHOP_Y - 12, 330, 92);
+    }
+    if (shop->panels[3].level != 0) {
+        NATIVE_MENU_HIDE(shop->layer, 180, 185, 145, 50);
+    }
+}
+#endif
+
 void STITSHOP_drawShop(ItemShop *shop, ItemShopWindows *win) {
     SpriteDrawer sprite;
 
+#ifdef NATIVE
+    if (native_portrait()) {
+        nativeShopLayout(shop);
+    }
+#endif
     initSpriteDrawer(&sprite);
     sprite.setLayerId(shop->layer, 1);
     sprite.setTexture(0x280, 0x100);
@@ -52,6 +71,16 @@
         shop->bgTick = 1;
