 /* Draws the list's frame, the items' icons and the blinking page arrows */
+#ifdef NATIVE
+/* Upright, for the finger, the shop's items (buying): one item per row, in their order, twice as big, the frame
+   stretched behind them, the page and its arrows under them without the shoulder buttons' labels,
+   then the item's details as they are (gpu_draw.c's layout) */
+#define NATIVE_SHOPLIST_Y 300
+static void nativeShopListLayout(ShopItemList *list) {
+    if (list->panel.level == 0 || list->selling) {
+        return;
+    }
+    s32 i;
+
+    for (i = 0; i < 8; i++) { /* item i: its row in the two columns, to row i */
+        NATIVE_MENU_PIECE(list->layer, (i % 2) * 131 + 18, 34 + (i / 2) * 14, 137 + (i % 2) * 14, 16, -2,
+                          NATIVE_SHOPLIST_Y + i * 28 - 2, 274 + (i % 2) * 28, 32);
+    }
+    NATIVE_MENU_PIECE(list->layer, 0, 28, 320, 84, 0, NATIVE_SHOPLIST_Y - 10, 320, 264);     /* the frame */
+    NATIVE_MENU_PIECE(list->layer, 0, 90, 320, 22, 0, NATIVE_SHOPLIST_Y + 230, 320, 22);     /* the page */
+    NATIVE_MENU_HIDE(list->layer, 43, 90, 24, 16);  /* "L1" */
+    NATIVE_MENU_HIDE(list->layer, 256, 90, 24, 16); /* "R1" */
+    NATIVE_MENU_PIECE(list->layer, 0, 110, 320, 130, 0, NATIVE_SHOPLIST_Y + 254, 320, 130); /* the details */
+}
+
+/* Upright, the finger on the list (nativeShopListLayout): a row tapped is chosen, tapped again bought (X); the page's
+   arrows turn it (L1, R1). Returns whether the selection moved */
+static s32 nativeShopListTouch(ShopItemList *list, ShopItemListWindows *win) {
+    s32 top = (native_field_h() - SCREEN_HEIGHT) / 2, first = list->page * list->pageSize, i, t, item;
+
+    for (i = 0; i < list->pageSize && first + i < list->count; i++) {
+        native_touch_target(i, 10, NATIVE_SHOPLIST_Y + i * 28 - top, 290, 28);
+    }
+    if (list->pages >= 2) {
+        native_touch_target(20, 0, NATIVE_SHOPLIST_Y + 222 - top, 90, 38);
+        native_touch_target(21, 230, NATIVE_SHOPLIST_Y + 222 - top, 90, 38);
+    }
+    t = native_touch_tap();
+    if (t == 20 || t == 21) {
+        native_touch_hold(t == 20 ? PAD_L1 : PAD_R1, 3);
+        return 0;
+    }
+    if (t < 0) {
+        return 0;
+    }
+    if (first + t == list->selection) {
+        native_touch_hold(PAD_CROSS, 3);
+        return 0;
+    }
+    list->selection = first + t;
+    item = list->selling == 0 ? list->shopItems[list->selection] : list->items[list->selection];
+    list->dialog->showItem(list->dialog, item, 1);
+    win->cursor->setPos(win->cursor, (list->selection % 2) * 0x83 + 0x1D, (list->selection % list->pageSize) / 2 * 0xE + 0x24);
+    SOUND.playSound(SOUND_CURSOR);
+    return 1;
+}
