+
+#define SDL_MIN_CURSOR(a, b) ((a) < (b) ? (a) : (b))
+
+/* The full-width Shift-JIS of a character typed on the phone, as the keys' glyphs are */
+static u16 nativeSjis(s32 ch) {
+    if (ch >= 'A' && ch <= 'Z') {
+        return 0x8260 + (ch - 'A');
+    }
+    if (ch >= 'a' && ch <= 'z') {
+        return 0x8281 + (ch - 'a');
+    }
+    if (ch >= '0' && ch <= '9') {
+        return 0x824F + (ch - '0');
+    }
+    switch (ch) {
+    case '-':
+        return 0x815D;
+    case '.':
+        return 0x8144;
+    case ',':
+        return 0x8143;
+    case '!':
+        return 0x8149;
+    case '?':
+        return 0x8148;
+    case '\'':
+        return 0x8166;
+    }
+    return 0;
+}
+
+/* Puts the cursor on the key of character ch, on whichever page has it: 1 if one does */
+static s32 nativeFindKey(NameEntry *task, NameEntryWindows *windows, s32 ch) {
+    u16 want = nativeSjis(ch);
+    s32 p, r, col;
+    u16 glyph;
+
+    for (p = 0; p < OVL_NAME(keyboard).pageCount; p++) {
+        for (r = 0; r < 7; r++) {
+            for (col = 0; col < 15; col++) {
+                if (OVL_NAME(keyboard).pages[p].cells[r][col].kind != 1) {
+                    continue;
+                }
+                glyph = windows->name->style->sjisMap[OVL_NAME(keyboard).pages[p].cells[r][col].code].code;
+                if ((want != 0 && glyph == want) || glyph == ch) {
+                    task->page = p, task->row = r, task->column = col;
+                    return 1;
+                }
+            }
+        }
+    }
+    return 0;
+}
+#endif
