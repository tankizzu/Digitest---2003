--- a/src/shared/name_entry/draw_keyboard.inc.c
+++ b/src/shared/name_entry/draw_keyboard.inc.c
@@ -8,7 +8,11 @@
     sprite.setTexture(task->vramX, task->vramY);
     sprite.setLayerId(task->layer, task->depth);
     if (task->keyboardScale.level != 0) {
+#ifdef NATIVE
+        if (task->active && !native_soft_keyboard()) { /* the phone's keyboard: no keys here, no cursor */
+#else
         if (task->active) {
+#endif
             if (GFX.funcs.getTime() - task->keyTime >= 5) {
