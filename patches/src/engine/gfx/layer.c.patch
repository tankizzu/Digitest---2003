     }
@@ -228,6 +243,11 @@
 s16 y;
 {
     layer->x = x;
+#ifdef NATIVE
+    if (layer->y >= NATIVE_FIELD_Y) { /* the upright field: the clip from its screen's top (portrait.c) */
+        y += NATIVE_FIELD_Y;
+    }
+#endif
     layer->y = y;
 }
 
@@ -245,6 +265,11 @@
 void layerGetViewRect(LayerView *layer, Rect16 *rect) {
     rect->x = layer->x - layer->offsetX + (layer->scrollX >> 8);
     rect->y = layer->y - layer->offsetY + (layer->scrollY >> 8);
+#ifdef NATIVE
+    if (layer->y >= NATIVE_FIELD_Y) { /* the upright field's screen, from its own top (portrait.c) */
+        rect->y -= NATIVE_FIELD_Y;
+    }
+#endif
     rect->w = layer->w;
     rect->h = layer->h;
 }
