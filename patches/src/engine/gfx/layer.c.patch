     env.ofs[0] = layer->offsetX;
     env.ofs[1] = layer->offsetY;
@@ -139,7 +148,13 @@
     dr = GFX.prim;
     ot = layer->ot[GFX.buffer] + layer->otLen;
     tag = ot - 1;
+#ifdef NATIVE
+    if (layer->env.clip.y >= NATIVE_FIELD_Y) { /* the upright field: one buffer, its offset from its own top (portrait.c) */
+        env.ofs[1] += NATIVE_FIELD_Y;
+    } else if (GFX.buffer != 0) {
+#else
     if (GFX.buffer != 0) {
