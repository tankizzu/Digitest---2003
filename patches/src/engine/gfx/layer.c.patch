@@ -132,6 +132,15 @@
     DR_ENV *dr;
     u_long *ot;
     u_long *tag;
+#ifdef NATIVE
+    s32 i;
+
+    for (i = 0; i < LAYER_COUNT; i++) { /* tests (DW3_HIDE_LAYERS): a layer not drawn, for a picture of the rest */
+        if (GFX.layers[i] == layer && native_test_layer_hidden(GFX.layerIds[i])) {
+            return;
+        }
