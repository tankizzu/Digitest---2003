 s32 FIELD_MENU_SPRITES[6] = { 29, 30, 31, 32, 33, 34 };
 
+#ifdef NATIVE
+/* SAVE (native.h, save_anywhere), the row before Quit: it opens the memory
+   card screen for saving, from where the player stands (GAME.fieldMode,
+   fieldPos and fieldDir, kept when this menu opens, are in the save).
+   Quit, the last row, asks in the title's banner, with three answers in place
+   of the rows (the title screen, the desktop, cancel).
+   packs_text: 142 Quit's row, 143 the question, 144-146 the answers, 147 SAVE */
+#define SAVE_TEXT 147
+#define QUIT_TEXT 142
+#define QUIT_ASK_TEXT 143
+#define QUIT_ANSWER_TEXT 144
+#define QUIT_BANNER_X 0x84 /* the question is longer than the title's text */
+static s32 quitAsk;
+static s32 quitRows; /* the rows the menu had, while it asks */
+static s32 quitToTitle;
+static s32 saveNow;
+
+/* A row's text: the game's, the journal's, SAVE's or Quit's */
+static void setFieldRow(FieldMenu *task, FieldMenuWindows *win, s32 i) {
+    void *own = (void *)native_packs_text(LANGUAGE);
+
+    if (i == task->count - 1) {
+        win->options[i]->setString(win->options[i], own, QUIT_TEXT);
+    } else if (g_save_anywhere && i == task->count - 2) {
+        win->options[i]->setString(win->options[i], own, SAVE_TEXT);
+    } else if (i == task->extraOption + 5) {
+        win->options[i]->setString(win->options[i], own, 15);
+    } else {
+        win->options[i]->setString(win->options[i], FILE_CACHE.load(TEXT_FILE(TEXT_STATUS)),
+                                   FIELD_MENU_OPTIONS[task->extraOption][i]);
+    }
+}
+
+/* Shows the question, or the rows again */
+static void showQuitAsk(FieldMenu *task, FieldMenuWindows *win, s32 ask) {
+    void *own = (void *)native_packs_text(LANGUAGE);
+    s32 i;
+
+    if (ask) {
+        quitRows = task->count;
+        task->count = 3;
+        win->title->setPos(win->title, QUIT_BANNER_X, 0x13);
+        win->title->setString(win->title, own, QUIT_ASK_TEXT);
+        for (i = 0; i < 3; i++) {
+            win->options[i]->setString(win->options[i], own, QUIT_ANSWER_TEXT + i);
+            win->options[i]->setPalette(win->options[i], PALETTE_WHITE);
+        }
+        for (i = 3; i < quitRows; i++) {
+            win->options[i]->setVisible(win->options[i], 0);
+        }
+    } else {
+        task->count = quitRows;
+        win->title->setPos(win->title, 0x98, 0x13);
+        win->title->setString(win->title, FILE_CACHE.load(TEXT_FILE(TEXT_STATUS)), 0x13);
+        for (i = 0; i < task->count; i++) {
+            setFieldRow(task, win, i);
+            win->options[i]->setVisible(win->options[i], 1);
+            win->options[i]->setPalette(win->options[i], i == 2 && task->option2Enabled == 0 ? PALETTE_GREY : PALETTE_WHITE);
+        }
+    }
+    quitAsk = ask;
+    task->cursor = ask ? 2 : task->count - 1; /* cancel / the Quit row */
+    win->cursor->setPos(win->cursor, 0xB0, task->cursor * 14 + 0x31);
+}
+
+/* Upright, for the finger (the user's layout demo, "Menu"): the options big (rows about 29 pixels high), the partners'
+   panels small side by side over them, the title over those, the money under the options (gpu_draw.c's layout). The
+   field's menu (its layer's 320x240 at the screen's top) and the field menu screens' (STSTATUS: in the middle) alike */
+#define NATIVE_OPT_K 208 /* the options' scale, in hundredths */
+#define NATIVE_OPT_X 9
+#define NATIVE_OPT_Y 239
+static s32 nativeMenuTop(FieldMenu *task) {
+    return task->layerId == 0x1000 ? (native_field_h() - SCREEN_HEIGHT) / 2 : 0; /* STSTATUS's SCREEN_LAYER: centred */
+}
+
+static void nativeMenuPiece(FieldMenu *task, s32 sx, s32 sy, s32 sw, s32 sh, s32 dx, s32 dy, s32 dw, s32 dh) {
+    /* the field's menu is on its map layer at depths 0-2 (the map's pieces from 3), STSTATUS's background at 7 */
+    native_layout_piece(task->layerId, task->layerId == 0x1000 ? 7 : 3, sx, sy, sw, sh, dx, dy - nativeMenuTop(task),
+                        dw, dh);
+}
+
+static void nativeFieldMenuLayout(FieldMenu *task) {
+    s32 i;
+
+    for (i = 0; i < 3; i++) {
+        if (task->panels[i].level != 0) {
+            nativeMenuPiece(task, 0, 15 + i * 46, 118, 48, 7 + i * 105, 195, 100, 41);
+        }
+    }
+    if (task->panels[0].level != 0) {
+        nativeMenuPiece(task, 30, 8, 300, 30, -25, 159, 300, 30); /* the title */
+    }
+    if (task->panels[1].level != 0) {
+        nativeMenuPiece(task, 166, 38, 170, 112 + (task->count > 7 ? (task->count - 7) * 14 : 0), NATIVE_OPT_X,
+                        NATIVE_OPT_Y, 170 * NATIVE_OPT_K / 100,
+                        (112 + (task->count > 7 ? (task->count - 7) * 14 : 0)) * NATIVE_OPT_K / 100);
+    }
+    if (task->panels[2].level != 0) {
+        nativeMenuPiece(task, 0, 155, 112, 24, 0, 492, 112, 24); /* the money */
+    }
+}
+
+/* touch: a row of the menu tapped picks it and confirms (X) */
+static s32 tapCross;
+static void tapRows(FieldMenu *task, FieldMenuWindows *win, s32 rows) {
+    s32 i, tapped;
+
+    native_touch_in_menu();
+    for (i = 0; i < rows; i++) {
+        if (native_portrait()) { /* upright: where the layout shows the row (nativeFieldMenuLayout) */
+            native_touch_target(i, 0, NATIVE_OPT_Y + (0x30 + i * 14 - 38) * NATIVE_OPT_K / 100 - nativeMenuTop(task), 320,
+                                14 * NATIVE_OPT_K / 100);
+            continue;
+        }
+        native_touch_target(i, 0xAC, 0x30 + i * 14, 132, 14);
+    }
+    tapped = native_touch_tap();
+    tapCross = tapped >= 0;
+    if (tapped >= 0 && tapped != task->cursor) {
+        task->cursor = tapped;
+        win->cursor->setPos(win->cursor, 0xB0, task->cursor * 14 + 0x31);
+    }
+}
+
+/* While it asks: up and down choose, X answers, triangle cancels. 1 to go to
+   the title screen */
+static s32 answerQuit(FieldMenu *task, FieldMenuWindows *win) {
+    s32 prev;
+
+    tapRows(task, win, 3);
+    prev = task->cursor;
+
+    if (PAD_PRESSED(PAD_UP) || PAD_REPEATED(PAD_UP)) {
+        if (--task->cursor < 0) {
+            task->cursor = 0;
+        }
+    } else if (PAD_PRESSED(PAD_DOWN) || PAD_REPEATED(PAD_DOWN)) {
+        if (++task->cursor > 2) {
+            task->cursor = 2;
+        }
+    }
+    if (prev != task->cursor) {
+        SOUND.playSound(SOUND_CURSOR);
+        win->cursor->setPos(win->cursor, 0xB0, task->cursor * 14 + 0x31);
+    } else if (PAD_PRESSED(PAD_CROSS) || tapCross) {
+        SOUND.playSound(SOUND_SELECT);
+        if (task->cursor == 1) {
+            native_quit();
+        }
+        if (task->cursor == 0) {
+            quitToTitle = 1;
+            return 1;
+        }
+        showQuitAsk(task, win, 0);
+    } else if (PAD_PRESSED(PAD_TRIANGLE)) {
+        SOUND.playSound(SOUND_MENU_CANCEL);
+        showQuitAsk(task, win, 0);
+    }
+    return 0;
+}
+#endif
